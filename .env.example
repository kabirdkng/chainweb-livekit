# Server (never expose these to the browser)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
# Optional: token TTL in seconds (default 3600)
LIVEKIT_TOKEN_TTL=

# Optional: S3-compatible storage for egress recordings
LIVEKIT_S3_ACCESS_KEY=
LIVEKIT_S3_SECRET=
LIVEKIT_S3_BUCKET=
LIVEKIT_S3_REGION=us-east-1
LIVEKIT_S3_ENDPOINT=
LIVEKIT_S3_FORCE_PATH_STYLE=true

# Browser
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
